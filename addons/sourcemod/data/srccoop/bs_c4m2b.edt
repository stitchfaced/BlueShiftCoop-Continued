#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m2c"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !activator
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !pvsplayer
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "SetTargetEntity"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on logic_branch -> !pvsplayer
		"modify"
		{
			"classname" "logic_branch"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on misc_marionettist -> !pvsplayer
		"modify"
		{
			"classname" "misc_marionettist"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on point_template -> !pvsplayer
		"modify"
		{
			"classname" "point_template"
			"outputs"
			{
				"modify"
				{
					"input" "TelekinesisPushOverriddenTarget"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_multiple -> !activator
		"modify"
		{
			"classname" "trigger_multiple"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_once -> !activator
		"modify"
		{
			"classname" "trigger_once"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_once -> !pvsplayer
		"modify"
		{
			"classname" "trigger_once"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1142608_OnTrigger"
		{
			"triggerid" "1142608"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_1977069_OnTrigger"
		{
			"triggerid" "1977069"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
