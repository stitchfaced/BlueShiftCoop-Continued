#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c2m0c"

	"equipment"
	{
		"lookup"
		{
			"targetname" "/^(suit|weapons)$/"
		}
	}

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1823783_OnClose"
		{
			"triggerid" "1823783"
			"output" "OnClose"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_1823783_OnOpen"
		{
			"triggerid" "1823783"
			"output" "OnOpen"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2046022_OnTrigger"
		{
			"triggerid" "2046022"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2084190_OnEndTouch"
		{
			"triggerid" "2084190"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2084253_OnEndTouch"
		{
			"triggerid" "2084253"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2144954_OnTrigger"
		{
			"triggerid" "2144954"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2352533_OnEndTouch"
		{
			"triggerid" "2352533"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3100540_OnTrigger"
		{
			"triggerid" "3100540"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1837605_OnTrigger"
		{
			"triggerid" "1837605"
			"output" "OnTrigger"
		}
		"auto_save_2768869_OnTrigger"
		{
			"triggerid" "2768869"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "-1176 623 137"
			"angles" "0 0 0"
		}

		"forkydoor1"
		{
			"origin" "-425 0 140"
			"angles" "0 0 0"
			"triggerid" "3100540"
			"output"	"OnTrigger"
			"portal"	 "-585 55 165"
			"delay" "0.5"
		}

		"autosave1"
		{
			"origin" "200 250 140"
			"angles" "0 0 0"
			"triggerid" "1837605"
			"output"	"OnTrigger"
		}

		"autosave2"
		{
			"origin" "548 -2056 140"
