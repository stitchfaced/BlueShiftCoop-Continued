#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}


		// protect only story-critical allies (death ends the map);
		// ordinary NPCs stay killable
		"modify"
		{
			"targetname" "/^bs_ally_/"
			"add"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}

		// co-op fix: this output swaps the allies' protection (above) for a weaker filter or none,
		// and every ally's death runs gameover_sci_init, which can't reload in co-op
		// (on c3m2a it disabled the exit: softlock, 2026-10-06). Keep them protected.
		"modify"
		{
			"targetname" "snarkattack_finalizer"
			"outputs"
			{
				"modify"
				{
					"output" "OnTrigger"
					"target" "bs_ally*"
					"input" "SetDamageFilter"
					"replace"
					{
						"parameter" "__srccoop_damage_filter"
					}
				}
			}
		}

		// co-op fix: this output swaps the allies' protection (above) for a weaker filter or none,
		// and every ally's death runs gameover_sci_init, which can't reload in co-op
		// (on c3m2a it disabled the exit: softlock, 2026-10-06). Keep them protected.
		"modify"
		{
			"targetname" "powerlift_cart"
			"outputs"
			{
				"modify"
				{
					"output" "OnStart"
					"target" "bs_ally*"
					"input" "SetDamageFilter"
					"replace"
					{
						"parameter" "__srccoop_damage_filter"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2919009_OnTrigger"
		{
			"triggerid" "2919009"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3028200_OnTrigger"
		{
			"triggerid" "3028200"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_434801_OnFullyClosed"
		{
			"triggerid" "434801"
			"output" "OnFullyClosed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2542104_OnPressed"
		{
			"triggerid" "2542104"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_3112425_OnTrigger"
		{
			"triggerid" "3112425"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"spawn"
		{
			"origin" "2076.68 2952 -1776"
			"angles" "0 90 0"
		}
	}
}
