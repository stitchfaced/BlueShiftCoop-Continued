#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c2m0b"

	"equipment"
	{
		"health" "24"
	}

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// protect only the two NPCs whose death (grd01) or player damage
		// (crowbar_sci) triggers gameover_load; was /^npc_human_/, which also
		// overrode the mapper's own filters on scripted-death scientists
		"modify"
		{
			"targetname" "/^(dc_hp_grd01|dc_hp_crowbar_sci)$/"
			"set"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1840232_OnTrigger"
		{
			"triggerid" "1840232"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_1885065_OnTrigger"
		{
			"triggerid" "1885065"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2441739_OnEndTouch"
		{
			"triggerid" "2441739"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2586693_OnEndTouch"
		{
			"triggerid" "2586693"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2586785_OnEndTouch"
		{
			"triggerid" "2586785"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3549131_OnTrigger"
		{
			"triggerid" "3549131"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2196791_OnTrigger"
		{
			"triggerid" "2196791"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_5064197_OnTrigger"
		{
			"triggerid" "5064197"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1864825_OnTrigger"
		{
			"triggerid" "1864825"
			"output" "OnTrigger"
		}
		"auto_save_2915781_OnTrigger"
		{
			"triggerid" "2915781"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "-672 159 273"
			"angles" "0 0 0"
		}

		"elev_rumble2"
		{
			"origin" "170 100 260"
			"angles" "0 0 0"
			"triggerid" "1864825"
			"output"	"OnTrigger"
		}

		"lcs_exitdoor_outro01"
		{
			"origin" "2095 830 140"
			"angles" "0 -90 0"
			"triggerid" "5091832"
			"portal"	"2096 930 150"
			"output"	"OnCase01"
		}

		"lab_blowdoor"
