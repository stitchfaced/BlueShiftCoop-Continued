#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c1m0c"

	"equipment"
	{
		"item" "item_weapon_crowbar"

		"health" "100"
		"armor" "60"
	}

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1328075_OnEndTouch"
		{
			"triggerid" "1328075"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_1646265_OnFullyOpen"
		{
			"triggerid" "1646265"
			"output" "OnFullyOpen"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2064292_OnStartTouch"
		{
			"triggerid" "2064292"
			"output" "OnStartTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2211100_OnTrigger"
		{
			"triggerid" "2211100"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3352692_OnEndTouch"
		{
			"triggerid" "3352692"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_4359832_OnFullyClosed"
		{
			"triggerid" "4359832"
			"output" "OnFullyClosed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_1540526_OnTrigger"
		{
			"triggerid" "1540526"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1427567_OnTrigger"
		{
			"triggerid" "1427567"
			"output" "OnTrigger"
		}
		"auto_save_1466180_OnTrigger"
		{
			"triggerid" "1466180"
			"output" "OnTrigger"
		}
		"auto_save_1596874_OnTrigger"
		{
			"triggerid" "1596874"
			"output" "OnTrigger"
		}
		"auto_save_3352707_OnTrigger"
		{
			"triggerid" "3352707"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "-16 -704.46 7.72644"
			"angles" "0 180 0"
		}

		"airlock"
		{
			"origin" "-1008 864 150"
			"angles" "0 90 0"
