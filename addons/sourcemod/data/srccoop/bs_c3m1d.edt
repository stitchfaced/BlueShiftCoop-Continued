#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c3m2a"

	"entity"
	{
		// co-op fix: when a train comes to rest inside a trigger, the touch lapses
		// and the next movement re-fires StartTouch, so any brake zone (end of line,
		// turntable blocker, coupling proxy) stopped it again instantly - the train
		// could never drive out of a zone it had stopped in (2026-10-06). Arm the
		// brake 0.5s after the train starts instead of instantly: the false
		// re-entry lands within ~0.01s and is ignored; real arrivals still brake.
		// (Verified live on bs_c3m1c via AddOutput before writing this.)
		"modify"
		{
			"targetname" "cftrain_engine"
			"outputs"
			{
				"modify"
				{
					"output" "OnStart"
					"target" "cftrain_engine_stop"
					"input" "Enable"
					"replace"
					{
						"delay" "0.5"
					}
				}
			}
		}

		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: the forward proxy's touch does not persist once the train
		// stops (EndTouch follows StartTouch ~0.2s later on this server), so
		// its EndTouch reset of the coupling state to 1 ("not at cargo") made
		// attach impossible: attack only ever buzzed. Keep the state at 2 after
		// touching; attach (case02) and detach (case03) still drive it.
		"modify"
		{
			"targetname" "cftrain_engine_forwardproxy"
			"outputs"
			{
				"remove"
				{
					"output" "OnEndTouch"
					"target" "cftrain_cargo_inputcondition"
					"input" "SetValue"
				}
				// same lapse: the front proxy's EndTouch disabled the final
				// restrictor before attack could fire it, so attach never welded
				// the carriage to the engine; it stayed a separate train that
				// stops at the end of track1, short of the cargolock1 dock (and
				// the engine drives into it). Seen live 2026-10-06.
				"remove"
				{
					"output" "OnEndTouch"
					"target" "cftrain_cargo_final_restrictor"
					"input" "Disable"
				}
			}
		}

		// co-op fix: singleplayer !player reference on func_button -> !activator
		"modify"
		{
			"classname" "func_button"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2717072_OnOut"
		{
			"triggerid" "2717072"
			"output" "OnOut"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3092375_OnOpen"
		{
			"triggerid" "3092375"
			"output" "OnOpen"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3201402_OnTrigger"
		{
			"triggerid" "3201402"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_3640445_OnTrigger"
		{
			"triggerid" "3640445"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2924776_OnIn"
		{
			"triggerid" "2924776"
			"output" "OnIn"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2924776_OnOut"
		{
			"triggerid" "2924776"
			"output" "OnOut"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_2732310_OnPressed"
		{
			"triggerid" "2732310"
			"output" "OnPressed"
		}
		"auto_save_3553534_OnPressed"
		{
			"triggerid" "3553534"
			"output" "OnPressed"
		}
		"auto_save_4078319_OnTrigger"
		{
			"triggerid" "4078319"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "843.823 1780.22 20.619"
			"angles" "0 341 0"
		}
	}
}