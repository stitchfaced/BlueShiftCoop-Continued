#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c3m2b"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}


		// protect only story-critical allies (death ends the map);
		// ordinary NPCs stay killable
		"modify"
		{
			"targetname" "/^bs_ally_/"
			"add"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}

		// co-op fix: opening the crate doors clears Rosenberg's damage filter
		// ("SetDamageFilter 0"), undoing the protection above. A player killed
		// him (2026-10-06): his death disables gChangelevel and cuts lcs_outbreak
		// short, which softlocks co-op (SP would just reload). Re-apply it.
		"modify"
		{
			"targetname" "prisoner2_door_btn"
			"outputs"
			{
				"modify"
				{
					"output" "OnPressed"
					"target" "bs_ally_rosenberg"
					"input" "SetDamageFilter"
					"replace"
					{
						"parameter" "__srccoop_damage_filter"
					}
				}
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2861433_OnPressed"
		{
			"triggerid" "2861433"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_3088931_OnTrigger"
		{
			"triggerid" "3088931"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_3290924_OnTrigger"
		{
			"triggerid" "3290924"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_3088931_OnStartTouch"
		{
			"triggerid" "3088931"
			"output" "OnStartTouch"
		}
		// co-op fix: the map spawn is the intro "void" room; intro_init teleports
		// players from there into Rosenberg's crate once, at map start. Until a
		// later checkpoint fired, a full-party wipe (or a join) respawned players
		// in the void with no way out (2026-10-06). Respawn in the crate instead.
		"intro_crate"
		{
			"origin" "2356 -1724 80"
			"angles" "0 90 0"
			"triggerid" "intro_init"
			"output" "OnTrigger"
		}
		// co-op fix: Rosenberg boosts one player through the crate's roof vent;
		// the boost's end teleports !player to the roof, but the second player
		// was left inside the crate, and the map's autosave there isn't a
		// checkpoint, so deaths respawned both players back in the crate
		// (2026-10-06). Respawn on the roof (spot verified standable live) and
		// bring every living player up when the boost finishes.
		"ventboost_roof"
		{
			"origin" "2352 -1805 212"
			"angles" "0 270 0"
			"triggerid" "interact_introscene_hands"
			"output" "OnAnimationDone"
			"bringall" "1"
		}
		"spawn"
		{
			"origin" "-9571.32 -2144 -624"
			"angles" "0 90 0"
		}
	}
}