#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c3m2c"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}


		// protect only story-critical allies (death ends the map);
		// ordinary NPCs stay killable
		"modify"
		{
			"targetname" "/^bs_ally_/"
			"add"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}

		// co-op fix: lcs_escort_enroute02 pauses (OnTrigger1) until all five
		// enroute_lead_staircase* ai_goal_leads report OnSuccess (counter to 5 ->
		// enroute_phase2_resumer Enable). In co-op none ever succeeds: all five
		// allies stood on their goals with both players beside them and the
		// counter stayed 0 (2026-10-06; likely WaitPointName "!player" has no
		// single player in MP - unconfirmed). Arm the players' resume trigger
		// when the scene pauses instead (verified live: enabling it unstuck it).
		"modify"
		{
			"targetname" "lcs_escort_enroute02"
			"outputs"
			{
				"add"
				{
					"output" "OnTrigger1"
					"target" "enroute_phase2_resumer"
					"input" "Enable"
					"parameter" ""
					"delay" "1"
					"timestofire" "1"
				}
			}
		}
		// co-op fix: lcs_escort_enroute01 pauses (OnTrigger1) until Rosenberg walks
		// into lcs_escort_enroute01_rosen_resumer, but in co-op he stays at
		// mark_enroute01_rosen_init and never does, so every ally freezes
		// (2026-10-06, twice; cause of him not walking unknown). Fallback: 6s after
		// the pause, put him in the resumer (what fixed it live). If he walks in
		// on his own, the resumer kills the fallback first.
		"create"
		{
			"classname" "point_teleport"
			"targetname" "coop_rosen_resume_tp"
			"origin" "-512 1294 202"
			"angles" "0 270 0"
			"target" "bs_ally_rosenberg"
		}
		"modify"
		{
			"targetname" "lcs_escort_enroute01_pause"
			"outputs"
			{
				"add"
				{
					"output" "OnTrigger"
					"target" "coop_rosen_resume_tp"
					"input" "Teleport"
					"parameter" ""
					"delay" "6"
					"timestofire" "1"
				}
			}
		}
		"modify"
		{
			"targetname" "lcs_escort_enroute01_rosen_resumer"
			"outputs"
			{
				"add"
				{
					"output" "OnTrigger"
					"target" "coop_rosen_resume_tp"
					"input" "Kill"
					"parameter" ""
					"delay" "0"
					"timestofire" "1"
				}
			}
		}

		// co-op fix: this output swaps the allies' protection (above) for a weaker filter or none,
		// and every ally's death runs gameover_sci_init, which can't reload in co-op
		// (on c3m2a it disabled the exit: softlock, 2026-10-06). Keep them protected.
		"modify"
		{
			"targetname" "trigger_thereheis"
			"outputs"
			{
				"modify"
				{
					"output" "OnTrigger"
					"target" "bs_ally_*"
					"input" "SetDamageFilter"
					"replace"
					{
						"parameter" "__srccoop_damage_filter"
					}
				}
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2255201_OnPressed"
		{
			"triggerid" "2255201"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"spawn"
		{
			"origin" "-123.32 1722.07 204.619"
			"angles" "0 57 0"
		}
	}
}