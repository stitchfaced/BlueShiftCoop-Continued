#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m0c"

	"entity"
	{
		// co-op fix: the crystal-cave trigger deleted a player-manned gun at +0 (same pattern as
		// the .50 cal that crashed both clients on bs_c3m1b, 2026-10-06).
		// Release the user first (func_tank and game_ui Deactivate), then
		// delete half a second later.
		"modify"
		{
			"hammerid" "343542"
			"outputs"
			{
				"modify"
				{
					"target" "func_demolisher*"
					"input" "Kill"
					"replace"
					{
						"delay" "0.5"
					}
				}
				"add"
				{
					"output" "OnTrigger"
					"target" "func_demolisher_tank"
					"input" "Deactivate"
					"parameter" ""
					"delay" "0"
					"timestofire" "-1"
				}
				"add"
				{
					"output" "OnTrigger"
					"target" "func_demolisher_controller"
					"input" "Deactivate"
					"parameter" ""
					"delay" "0"
					"timestofire" "-1"
				}
			}
		}

		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !activator
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on logic_branch -> !pvsplayer
		"modify"
		{
			"classname" "logic_branch"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_save_193798_OnTrigger"
		{
			"triggerid" "193798"
			"output" "OnTrigger"
		}
		"auto_save_2025471_OnTrigger"
		{
			"triggerid" "2025471"
			"output" "OnTrigger"
		}
		"auto_save_2025885_OnTrigger"
		{
			"triggerid" "2025885"
			"output" "OnTrigger"
		}
		"auto_save_230444_OnTrigger"
		{
			"triggerid" "230444"
			"output" "OnTrigger"
		}
		"auto_save_343542_OnTrigger"
		{
			"triggerid" "343542"
			"output" "OnTrigger"
		}
		"auto_save_3949484_OnTrigger"
		{
			"triggerid" "3949484"
			"output" "OnTrigger"
		}
		"auto_save_670756_OnTrigger"
		{
			"triggerid" "670756"
			"output" "OnTrigger"
		}
		// co-op fix: trigger #342641 enables backtrack2_clip (an invisible
		// no-going-back wall) and swaps the worldsplitter areaportals, but the
		// latest respawn point was still behind that wall (2026-10-06: players
		// respawned into it). Respawn where the triggering player crossed, and
		// bring anyone left behind through before the wall goes up.
		"backtrack2_crossed"
		{
			"triggerid" "342641"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"spawn"
		{
			"origin" "-9282.7 -6695.9 1908.87"
			"angles" "0 11 0"
		}
	}
}
