		}
		"auto_lock_849255_OnTrigger"
		{
			"triggerid" "849255"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_899331_OnLockedUse"
		{
			"triggerid" "899331"
			"output" "OnLockedUse"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_93559_OnTrigger"
		{
			"triggerid" "93559"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_1274437_OnPressed"
		{
			"triggerid" "1274437"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_1274437_OnUnpressed"
		{
			"triggerid" "1274437"
			"output" "OnUnpressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1754517_OnTrigger"
		{
			"triggerid" "1754517"
			"output" "OnTrigger"
		}
		"auto_save_1899562_OnTrigger"
		{
			"triggerid" "1899562"
			"output" "OnTrigger"
		}
		"auto_save_2168148_OnTrigger"
		{
			"triggerid" "2168148"
			"output" "OnTrigger"
		}
		"auto_save_641246_OnClose"
		{
			"triggerid" "641246"
			"output" "OnClose"
		}
		"auto_save_849178_OnTrigger"
		{
			"triggerid" "849178"
			"output" "OnTrigger"
		}
		"auto_save_849243_OnTrigger"
		{
			"triggerid" "849243"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "6.41 64 -624"
			"angles" "0 90 0"
		}
	}
}
