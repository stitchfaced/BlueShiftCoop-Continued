#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m1c"

	"entity"
	{
		// co-op fix: the scripted railgun blow-up deleted a player-manned gun at +0 (same pattern as
		// the .50 cal that crashed both clients on bs_c3m1b, 2026-10-06).
		// Release the user first (func_tank and game_ui Deactivate), then
		// delete half a second later.
		"modify"
		{
			"targetname" "railgun_blowup_rel"
			"outputs"
			{
				"modify"
				{
					"target" "func_railgun*"
					"input" "KillHierarchy"
					"replace"
					{
						"delay" "0.5"
					}
				}
				"add"
				{
					"output" "OnTrigger"
					"target" "func_railgun_tank"
					"input" "Deactivate"
					"parameter" ""
					"delay" "0"
					"timestofire" "-1"
				}
				"add"
				{
					"output" "OnTrigger"
					"target" "func_railgun_controller"
					"input" "Deactivate"
					"parameter" ""
					"delay" "0"
					"timestofire" "-1"
				}
			}
		}

		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !activator
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !pvsplayer
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "SetTargetEntity"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on logic_timer -> !pvsplayer
		"modify"
		{
			"classname" "logic_timer"
			"outputs"
			{
				"modify"
				{
					"input" "SetTargetEntity"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_multiple -> !pvsplayer
		"modify"
		{
			"classname" "trigger_multiple"
			"outputs"
			{
				"modify"
				{
					"input" "SetTargetEntity"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1860946_OnTrigger"
		{
			"triggerid" "1860946"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_309169_OnTrigger"
		{
			"triggerid" "309169"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_503655_OnTrigger"
		{
			"triggerid" "503655"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_2074695_OnTrigger"
		{
			"triggerid" "2074695"
			"output" "OnTrigger"
		}
		"auto_save_392652_OnTrigger"
		{
			"triggerid" "392652"
			"output" "OnTrigger"
		}
		"auto_save_392737_OnTrigger"
		{
			"triggerid" "392737"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "-7753.15 6030.7 1865.39"
			"angles" "0 90 0"
		}
	}
}
