		}


	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		"modify"
		{
			"classname" "item_suit"
			"targetname" "Suit"
			"outputs"
			{
				"modify"
				{
					"output" "OnPlayerPickup"
					"replace"
					{
						"timestofire" "1"
					}
				}
			}
		}

		"modify"
		{
			"classname" "func_button"
			"targetname" "Calhoun_uniform_btn"
			"outputs"
			{
				"remove"
				{
					"target" "Calhoun_uniform"
				}
			}
		}

		"delete"
		{
			"targetname" "clearwpn_4evaaaa"
		}
		// protect guards whose death (grd19) or player damage (grd07/08/13)
		// triggers gameover_load - in co-op one stray hit reloads everyone
		"modify"
		{
			"targetname" "/^ins_sec_grd(07|08|13|19)$/"
			"set"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2304103_OnFullyClosed"
		{
