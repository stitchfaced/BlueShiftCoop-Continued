#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c3m0b"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_button -> !activator
		"modify"
		{
			"classname" "func_button"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_1140592_OnClose"
		{
			"triggerid" "1140592"
			"output" "OnClose"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_1618322_OnTrigger"
		{
			"triggerid" "1618322"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_695532_OnTrigger"
		{
			"triggerid" "695532"
			"output" "OnTrigger"
		}
		"auto_save_892026_OnTrigger"
		{
			"triggerid" "892026"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "-192 -94.0991 481"
			"angles" "0 0 0"
		}
	}
}