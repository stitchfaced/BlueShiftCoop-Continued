#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m0a"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}


		// protect only story-critical allies (death ends the map);
		// ordinary NPCs stay killable
		"modify"
		{
			"targetname" "/^bs_ally_/"
			"add"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2208787_OnTrigger"
		{
			"triggerid" "2208787"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2209088_OnTrigger"
		{
			"triggerid" "2209088"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_2314785_OnTrigger"
		{
			"triggerid" "2314785"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2208764_OnTrigger"
		{
			"triggerid" "2208764"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_2964445_OnPressed"
		{
			"triggerid" "2964445"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_2226732_OnTrigger"
		{
			"triggerid" "2226732"
			"output" "OnTrigger"
		}
		// co-op fix: the map spawn is inside the elevator at the TOP of its shaft;
		// players who died during the ride respawned there after the cabin had
		// gone down and dropped onto its roof (2026-10-06). Spawn at the cabin's
		// centre instead (it is 167x227x143, so its centre is ~64u above the
		// floor), wherever the cabin is. Map-start spawn is unchanged in effect.
		"spawn"
		{
			"followid" "proto_elevator_cabin"
			"angles" "0 90 0"
		}
	}
}