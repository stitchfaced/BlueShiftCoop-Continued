#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m0b"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_tank -> !activator
		"modify"
		{
			"classname" "func_tank"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_466470_OnEndTouch"
		{
			"triggerid" "466470"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_466516_OnEndTouch"
		{
			"triggerid" "466516"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lock_466553_OnEndTouch"
		{
			"triggerid" "466553"
			"output" "OnEndTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1302656_OnStartTouch"
		{
			"triggerid" "1302656"
			"output" "OnStartTouch"
		}
		"auto_save_1373500_OnTrigger"
		{
			"triggerid" "1373500"
			"output" "OnTrigger"
		}
		"auto_save_1756600_OnTrigger"
		{
			"triggerid" "1756600"
			"output" "OnTrigger"
		}
		"auto_save_663556_OnTrigger"
		{
			"triggerid" "663556"
			"output" "OnTrigger"
		}
		// co-op fix: reaching the far end of the giant root (trigger #1360561) plays
		// cinephys2 and DisableCollision on brokenroot_mdl and enables the no-return
		// brush. Anyone still on/behind it falls, and a death respawns players at
		// an earlier checkpoint on the start side with no way across (2026-10-06).
		// Checkpoint on the far ledge (floor traced live: ~2620, hull clear) and
		// bring everyone over when the root goes.
		"root_far_end"
		{
			"origin" "960 4500 2645"
			"angles" "0 0 0"
			"triggerid" "1360561"
			"output" "OnTrigger"
			"bringall" "1"
		}
		"spawn"
		{
			"origin" "-10178 -9214.66 12360"
			"angles" "0 90 0"
		}
	}
}
