#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c4m2b"

	"entity"
	{
		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on logic_branch -> !activator
		"modify"
		{
			"classname" "logic_branch"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on logic_relay -> !activator
		"modify"
		{
			"classname" "logic_relay"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on logic_relay -> !pvsplayer
		"modify"
		{
			"classname" "logic_relay"
			"outputs"
			{
				"modify"
				{
					"input" "TelekinesisPushOverriddenTarget"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on misc_marionettist -> !pvsplayer
		"modify"
		{
			"classname" "misc_marionettist"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_multiple -> !pvsplayer
		"modify"
		{
			"classname" "trigger_multiple"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_multiple -> !pvsplayer
		"modify"
		{
			"classname" "trigger_multiple"
			"outputs"
			{
				"modify"
				{
					"input" "SetTargetEntity"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}

		// co-op fix: singleplayer !player reference on trigger_once -> !pvsplayer
		"modify"
		{
			"classname" "trigger_once"
			"outputs"
			{
				"modify"
				{
					"input" "Manipulate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!pvsplayer"
					}
				}
			}
		}
	}

	// spawn taken from the map's first info_player_start
	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_395725_OnPressed"
		{
			"triggerid" "395725"
			"output" "OnPressed"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_3568029_OnTrigger"
		{
			"triggerid" "3568029"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_3568051_OnTrigger"
		{
			"triggerid" "3568051"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_4665062_OnTrigger"
		{
			"triggerid" "4665062"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_552289_OnReachedPosition"
		{
			"triggerid" "552289"
			"output" "OnReachedPosition"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_1317806_OnTrigger"
		{
			"triggerid" "1317806"
			"output" "OnTrigger"
		}
		"auto_save_3570738_OnTrigger"
		{
			"triggerid" "3570738"
			"output" "OnTrigger"
		}
		"auto_save_418376_OnTrigger"
		{
			"triggerid" "418376"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "152 -5578.52 -24"
			"angles" "0 90 0"
		}
	}
}
