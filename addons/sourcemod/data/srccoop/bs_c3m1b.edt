#base "base/bshift_sp_campaign.edt"

"config"
{
	"chapter" "Blue Shift"
	// co-op fix: SourceCoop restores your saved loadout only while the map is
	// on its first checkpoint; after a mid-map checkpoint respawns get the
	// default kit, which had no suit -> no HUD. The vest is picked up on
	// bs_c1m0a, so every later map gets it in the respawn kit.
	"equipment_suit"
	{
		"item" "item_suit"
	}
	"nextmap" "bs_c3m1c"

	// train hints go to the player they are about (who walked up / took the
	// controls), not to everyone - the base shows every env_hudhint to all
	"define"
	{
		"env_hudhint_allplayers" "0"
	}

	"entity"
	{
		// co-op fix: when a train comes to rest inside a trigger, the touch lapses
		// and the next movement re-fires StartTouch, so any brake zone (end of line,
		// turntable blocker, coupling proxy) stopped it again instantly - the train
		// could never drive out of a zone it had stopped in (2026-10-06). Arm the
		// brake 0.5s after the train starts instead of instantly: the false
		// re-entry lands within ~0.01s and is ignored; real arrivals still brake.
		// (Verified live on bs_c3m1c via AddOutput before writing this.)
		"modify"
		{
			"targetname" "cftrain_engine"
			"outputs"
			{
				"modify"
				{
					"output" "OnStart"
					"target" "cftrain_engine_stop"
					"input" "Enable"
					"replace"
					{
						"delay" "0.5"
					}
				}
			}
		}

		"modify"
		{
			"classname" "logic_auto"
			"functions"
			{
				"delay_output" "OnMapSpawn"
				"delay_output" "OnNewGame"
			}
		}

		// co-op fix: singleplayer !player reference on func_button -> !activator
		"modify"
		{
			"classname" "func_button"
			"outputs"
			{
				"modify"
				{
					"input" "Activate"
					"parameter" "!player"
					"replace"
					{
						"parameter" "!activator"
					}
				}
			}
		}

		// co-op fix: the forward proxy's touch does not persist once the train
		// stops (EndTouch follows StartTouch ~0.2s later on this server), so
		// its EndTouch reset of the coupling state to 1 ("not at cargo") made
		// attach impossible: attack only ever buzzed. Keep the state at 2 after
		// touching; attach (case02) and detach (case03) still drive it.
		"modify"
		{
			"targetname" "cftrain_engine_forwardproxy"
			"outputs"
			{
				"remove"
				{
					"output" "OnEndTouch"
					"target" "cftrain_cargo_inputcondition"
					"input" "SetValue"
				}
			}
		}

		// ...except the cargo hint: it is fired by map logic with no reliable
		// player activator, so keep it visible to everyone
		"modify"
		{
			"targetname" "hudhint_train_cargo"
			"flags"
			{
				"spawnflags"
				{
					"add" "1"
				}
			}
		}

		// co-op fix: the scripted .50 cal destruction deleted the gun (and its
		// model) while a player was using it; on 2026-10-06 both clients crashed
		// at that moment. Release the user first (func_tank Deactivate drops
		// the controller), then delete the gun and model half a second later.
		"modify"
		{
			"targetname" "relay_50cal_destroy"
			"outputs"
			{
				"modify"
				{
					"target" "/^50cal_(tank|prop)$/"
					"input" "Kill"
					"replace"
					{
						"delay" "0.5"
					}
				}
				"add"
				{
					"output" "OnTrigger"
					"target" "50cal_tank"
					"input" "Deactivate"
					"parameter" ""
					"delay" "0"
					"timestofire" "-1"
				}
			}
		}

		// co-op fix: Captive Freight cargo coupling. cftrain_engine_forwardproxy
		// is parented to cftrain_cargo, which starts parented to the engine. In
		// co-op the coupled proxy's touch flickers (StartTouch + EndTouch) on
		// every move, and StartTouch fires cftrain_engine_stop - so the scripted
		// roll-back into the depot (relay_cftrain_startbackwards) and every
		// throttle input stop after ~0.1 units, leaving the train unusable.
		// Keep both proxies off until the roll-back has dropped the cargo at
		// cftrain_track1_1 and the engine has hit its stop at x~2040 (#4707031),
		// then hand them back. Diagnosed live 2026-10-06 with an engine I/O trace.
		"modify"
		{
			"targetname" "cftrain_engine_forwardproxy"
			"set"
			{
				"StartDisabled" "1"
			}
		}
		"modify"
		{
			"hammerid" "4707031"
			"outputs"
			{
				"add"
				{
					"output" "OnTrigger"
					"target" "cftrain_engine_forwardproxy"
					"input" "Enable"
					"parameter" ""
					"delay" "0.5"
					"timestofire" "1"
				}
			}
		}

		// protect only story-critical allies (death ends the map);
		// ordinary NPCs stay killable
		"modify"
		{
			"targetname" "/^bs_ally_/"
			"add"
			{
				"damagefilter" "__srccoop_damage_filter"
			}
		}
	}

	"checkpoint"
	{
		// co-op fix: respawn past doors that lock behind players. Generated by
		// gen_respawn.py: one position-less checkpoint (= where the activating
		// player stood) per player-triggered autosave call and door lock;
		// door-lock ones also bring living stragglers (bringall).
		"use_map_autosave" "1"
		"auto_lock_2196017_OnTrigger"
		{
			"triggerid" "2196017"
			"output" "OnTrigger"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_lockroot_4130435_OnStartTouch"
		{
			"triggerid" "4130435"
			"output" "OnStartTouch"
			"bringall" "1"
			"bringall_radius" "96"
		}
		"auto_save_2335293_OnTrigger"
		{
			"triggerid" "2335293"
			"output" "OnTrigger"
		}
		"auto_save_2706273_OnTrigger"
		{
			"triggerid" "2706273"
			"output" "OnTrigger"
		}
		"auto_save_2838864_OnTrigger"
		{
			"triggerid" "2838864"
			"output" "OnTrigger"
		}
		// hand-placed: door 2 (depot_exit_door2, no handle) closes behind the
		// players once Otis walks through #2903612 (NPC-only) and arms the
		// map-sized trigger depot_exit_door2_Close - no player trigger marks the
		// crossing, so use a fixed spot on the railyard side (floor node). No
		// bringall: the room behind is inside any useful grace radius.
		"door2_closed_railyard"
		{
			"origin" "1664.8 -141.9 33"
			"angles" "0 270 0"
			"triggerid" "depot_exit_door2_Close"
			"output" "OnTrigger"
		}
		"spawn"
		{
			"origin" "6062.78 -1512.22 284.619"
			"angles" "0 161 0"
		}
	}
}